APP_NAME=TurboStore
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# LOCAL: use Mailtrap → mailtrap.io (free, catches emails without sending them)
# PROD:  replace with Gmail / Mailgun / SendGrid credentials
# Used for: password reset, email verification, wallet funding confirmations.
# MAIL_SCHEME must be "smtp" (STARTTLS, ports 587/2525) or "smtps" (implicit TLS, port 465).
# "tls"/"ssl" are NOT valid in Laravel 12 and will make every email fail.
# Funding confirmations are queued: a queue worker must be running (php artisan queue:work).
MAIL_MAILER=smtp
MAIL_SCHEME=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@turbostore.com"
MAIL_FROM_NAME="TurboStore"

JWT_SECRET=

# Paystack (dashboard → Settings → API Keys & Webhooks). Use sk_test_/pk_test_ locally.
# Webhook URL: {APP_URL}/api/wallet/fund/webhook
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=

# Waitlist launch campaign — reads the Klaviyo list the waitlist site writes to.
# Create a Klaviyo private key with READ-ONLY scopes: Lists (read) + Profiles (read).
# The list ID must match KLAVIYO_WAITLIST_LIST_ID in the waitlist project.
KLAVIYO_PRIVATE_API_KEY=
KLAVIYO_WAITLIST_LIST_ID=
# Delivery pacing: LAUNCH_EMAIL_BATCH_SIZE emails every LAUNCH_EMAIL_BATCH_DELAY seconds.
# Keep within your SMTP provider's sending limits.
LAUNCH_EMAIL_BATCH_SIZE=50
LAUNCH_EMAIL_BATCH_DELAY=60
# How long activation / verification links in the launch email stay valid.
LAUNCH_ACTIVATION_TTL_DAYS=7

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
